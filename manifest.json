{
  "manifest_version": 3,
  "name": "YouTube Standalone Opener",
  "version": "1.0",
  "description": "Automatically opens YouTube playlist videos as standalone videos.",
  "icons": {
    "128": "icon.png"
  },
  "permissions": [
    "webNavigation",
    "tabs"
  ],
  "host_permissions": [
    "https://youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
